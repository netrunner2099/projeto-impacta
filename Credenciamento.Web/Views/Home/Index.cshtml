@model HomeIndexViewModel
@{
    ViewData["Title"] = "Eventos Incríveis Aguardando Você";
}

<!-- Hero Banner com Carrossel -->
<section class="hero-banner mb-5 mt-2">
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
        <!-- Indicators -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="São Paulo"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Ribeirão Preto"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Belo Horizonte"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Rio de Janeiro"></button>
        </div>

        <!-- Slides -->
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/img/hero-banner-sp.jpg" class="d-block w-100" alt="São Paulo">
                <div class="carousel-overlay"></div>
            </div>
            <div class="carousel-item active">
                <img src="~/img/hero-banner-rp.jpg" class="d-block w-100" alt="Ribeirão Preto">
                <div class="carousel-overlay"></div>
            </div>
            <div class="carousel-item">
                <img src="~/img/hero-banner-bh.jpg" class="d-block w-100" alt="Belo Horizonte">
                <div class="carousel-overlay"></div>
            </div>
            <div class="carousel-item">
                <img src="~/img/hero-banner-rj.jpg" class="d-block w-100" alt="Rio de Janeiro">
                <div class="carousel-overlay"></div>
            </div>
        </div>

        @* <!-- Controles -->
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Próximo</span>
        </button> *@

        <!-- Conteúdo sobreposto -->
        <div class="hero-content p-4">
            <div class="container py-5">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h1 class="display-3 fw-bold text-white mb-3 animate-fade-in text-shadow">
                            Viva Momentos Inesquecíveis 🎉
                        </h1>
                        <p class="lead text-white mb-4 animate-fade-in-delay text-shadow">
                            Descubra os melhores eventos, shows e experiências.
                            Garanta seu ingresso agora e não perca nenhuma emoção!
                        </p>
                        <div class="d-flex gap-3 animate-fade-in-delay-2 flex-wrap">
                            <a href="#eventos" class="btn btn-primary btn-lg shadow-lg pulse-btn">
                                <i class="bi bi-ticket-perforated me-2"></i>Ver Eventos
                            </a>
                            @if (Model.User == null)
                            {
                                <a asp-controller="Login" asp-action="Index" class="btn btn-outline-light btn-lg border-2">
                                    <i class="bi bi-person-circle me-2"></i>Entrar
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Profile" asp-action="Index" class="btn btn-light btn-lg">
                                    <i class="bi bi-person-circle me-2"></i>Meu Perfil
                                </a>
                            }
                        </div>
                    </div>
                    <div class="col-lg-4 text-center d-none d-lg-block">
                        <div class="hero-illustration">
                            <i class="bi bi-calendar-event display-1 text-white pulse"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Estatísticas Rápidas -->
<section class="stats-section mb-5">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <i class="bi bi-calendar-check display-4 text-primary mb-2"></i>
                    <h3 class="fw-bold counter" data-target="@(Model.Events?.Count() ?? 0)">0</h3>
                    <p class="text-muted mb-0">Eventos Disponíveis</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <i class="bi bi-people display-4 text-success mb-2"></i>
                    <h3 class="fw-bold counter" data-target="5000">0</h3>
                    <p class="text-muted mb-0">Participantes</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <i class="bi bi-star-fill display-4 text-warning mb-2"></i>
                    <h3 class="fw-bold">4.8/5</h3>
                    <p class="text-muted mb-0">Avaliação</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <i class="bi bi-shield-check display-4 text-info mb-2"></i>
                    <h3 class="fw-bold">100%</h3>
                    <p class="text-muted mb-0">Seguro</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Seção de Eventos -->
<section id="eventos" class="events-section mb-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12 text-center">
                <h2 class="display-5 fw-bold mb-2">
                    <i class="bi bi-calendar-event-fill me-2 text-primary"></i>
                    Próximos Eventos
                </h2>
                <p class="text-muted">Selecione o evento perfeito para você</p>
            </div>
        </div>

        @if (Model?.Events != null && Model.Events.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model.Events)
                {
                    <div class="col-lg-6 col-xl-4">
                        <div class="event-card shadow-sm h-100">
                            <!-- Badge de Status -->
                            <div class="event-badge">
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>Disponível
                                </span>
                            </div>

                            <!-- Header do Card -->
                            <div class="event-card-header">
                                <div class="event-date-badge">
                                    <div class="date-day">@item.Begin.ToString("dd")</div>
                                    <div class="date-month">@item.Begin.ToString("MMM").ToUpper()</div>
                                </div>
                                <div class="event-category">
                                    <i class="bi bi-music-note-beamed me-1"></i>Evento
                                </div>
                            </div>

                            <!-- Corpo do Card -->
                            <div class="event-card-body">
                                <h5 class="event-title mb-3">@item.Name</h5>

                                <div class="event-info mb-2">
                                    <i class="bi bi-geo-alt-fill text-danger me-2"></i>
                                    <span>@item.Local</span>
                                </div>

                                <div class="event-info mb-2">
                                    <i class="bi bi-calendar3 text-primary me-2"></i>
                                    <span>@item.Begin.ToString("dd/MM/yyyy") - @item.End.ToString("dd/MM/yyyy")</span>
                                </div>

                                <div class="event-info mb-3">
                                    <i class="bi bi-clock text-info me-2"></i>
                                    <span>@item.Begin.ToString("HH:mm")</span>
                                </div>

                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="event-description text-muted">
                                        @(item.Description.Length > 120 ? item.Description.Substring(0, 120) + "..." : item.Description)
                                    </p>
                                }

                                <!-- Preço e Ação -->
                                <div class="event-footer">
                                    <div class="event-price">
                                        <small class="text-muted d-block">A partir de</small>
                                        <h4 class="text-success fw-bold mb-0">@item.Price.ToString("C2")</h4>
                                    </div>
                                    <button type="button" class="btn btn-primary btn-buy" data-id="@item.EventId">
                                        <i class="bi bi-cart-plus me-2"></i>Comprar
                                    </button>
                                </div>
                            </div>

                            <!-- Hover Overlay -->
                            <div class="event-card-overlay">
                                <button type="button" class="btn btn-light btn-lg btn-buy" data-id="@item.EventId">
                                    <i class="bi bi-ticket-perforated me-2"></i>Garantir Ingresso
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-info text-center shadow-sm border-0">
                        <i class="bi bi-info-circle display-4 d-block mb-3"></i>
                        <h4>Nenhum evento disponível no momento</h4>
                        <p class="mb-0">Novos eventos em breve! Volte mais tarde.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Call to Action -->
<section class="cta-section mb-5">
    <div class="container">
        <div class="cta-box text-center p-5 rounded shadow-lg">
            <h2 class="text-white mb-3 fw-bold">Não Perca Nenhum Evento!</h2>
            <p class="text-white mb-4 lead">Cadastre-se e receba notificações sobre novos eventos</p>
            @if (Model.User == null)
            {
                <a asp-controller="Onboard" asp-action="Index" class="btn btn-light btn-lg shadow">
                    <i class="bi bi-person-plus me-2"></i>Criar Conta Grátis
                </a>
            }
            else
            {
                <a asp-controller="Profile" asp-action="Index" class="btn btn-light btn-lg shadow">
                    <i class="bi bi-person-circle me-2"></i>Meu Perfil
                </a>
            }
        </div>
    </div>
</section>

<!-- Estilos Customizados -->
<style>
    /* Hero Banner com Carrossel */
    .hero-banner {
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        margin-top: -1rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    }

    #heroCarousel {
        position: relative;
        min-height: 500px;
    }

    .carousel-item {
        height: 500px;
        position: relative;
    }

        .carousel-item img {
            object-fit: cover;
            height: 100%;
            width: 100%;
        }

    .carousel-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.8) 0%, rgba(118, 75, 162, 0.8) 100%);
    }

    .hero-content {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 10;
        display: flex;
        align-items: center;
    }

    .carousel-indicators {
        z-index: 15;
    }

        .carousel-indicators button {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin: 0 5px;
        }

    .carousel-control-prev,
    .carousel-control-next {
        z-index: 15;
        width: 5%;
    }

    .text-shadow {
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
    }

    /* Animações */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
        }
    }

    @@keyframes pulseBtn {
        0%, 100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(0, 123, 255, 0.7);
        }

        50% {
            transform: scale(1.05);
            box-shadow: 0 0 0 10px rgba(0, 123, 255, 0);
        }
    }

    .animate-fade-in {
        animation: fadeIn 1s ease-out;
    }

    .animate-fade-in-delay {
        animation: fadeIn 1s ease-out 0.3s backwards;
    }

    .animate-fade-in-delay-2 {
        animation: fadeIn 1s ease-out 0.6s backwards;
    }

    .pulse {
        animation: pulse 2s infinite;
    }

    .pulse-btn {
        animation: pulseBtn 2s infinite;
    }

    /* Stats Cards */
    .stat-card {
        padding: 2rem 1rem;
        background: white;
        border-radius: 15px;
        transition: all 0.3s ease;
        border: 1px solid #f0f0f0;
        cursor: pointer;
    }

        .stat-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        }

        .stat-card i {
            transition: transform 0.3s ease;
        }

        .stat-card:hover i {
            transform: scale(1.2);
        }

    /* Event Cards */
    .event-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
        position: relative;
    }

        .event-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        }

            .event-card:hover .event-card-overlay {
                opacity: 1;
                visibility: visible;
            }

    .event-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 2;
    }

    .event-card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 2rem;
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .event-date-badge {
        background: white;
        border-radius: 15px;
        padding: 1rem;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .date-day {
        font-size: 2rem;
        font-weight: bold;
        color: #667eea;
        line-height: 1;
    }

    .date-month {
        font-size: 0.875rem;
        font-weight: 600;
        color: #764ba2;
    }

    .event-category {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        color: white;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .event-card-body {
        padding: 1.5rem;
    }

    .event-title {
        font-size: 1.25rem;
        font-weight: bold;
        color: #2c3e50;
        min-height: 3rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .event-info {
        display: flex;
        align-items: center;
        font-size: 0.9rem;
        color: #6c757d;
    }

    .event-description {
        font-size: 0.9rem;
        line-height: 1.6;
        min-height: 3rem;
    }

    .event-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #e9ecef;
    }

    .event-price h4 {
        font-size: 1.5rem;
    }

    .event-card-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.95) 0%, rgba(118, 75, 162, 0.95) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    /* CTA Section */
    .cta-box {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    /* Responsivo */
    @@media (max-width: 768px) {
        #heroCarousel,
        .carousel-item {
            height: 400px;
        }

        .hero-banner h1 {
            font-size: 2rem;
        }

        .hero-banner .lead {
            font-size: 1rem;
        }

        .stat-card {
            padding: 1.5rem 0.5rem;
        }
    }
</style>

<script type="text/javascript">
    $(document).ready(function () {
        // Inicializar carrossel com intervalo de 5 segundos
        var carousel = new bootstrap.Carousel(document.getElementById('heroCarousel'), {
            interval: 5000,
            ride: 'carousel',
            pause: 'hover'
        });

        // Smooth scroll para seção de eventos
        $('a[href="#eventos"]').click(function(e) {
            e.preventDefault();
            $('html, body').animate({
                scrollTop: $('#eventos').offset().top - 100
            }, 800);
        });

        // Comprar ingresso
        $('.btn-buy').click(function () {
            var eventId = $(this).data('id');
            window.location.href = '/Store/Index/' + eventId;
        });

        // Contador animado
        const counters = document.querySelectorAll('.counter');
        const speed = 200;

        counters.forEach(counter => {
            const updateCount = () => {
                const target = +counter.getAttribute('data-target');
                const count = +counter.innerText;
                const inc = target / speed;

                if (count < target) {
                    counter.innerText = Math.ceil(count + inc);
                    setTimeout(updateCount, 1);
                } else {
                    counter.innerText = target;
                }
            };

            const observer = new IntersectionObserver((entries) => {
                if (entries[0].isIntersecting) {
                    updateCount();
                    observer.disconnect();
                }
            });

            observer.observe(counter);
        });

        // Animação de entrada dos cards
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const cardObserver = new IntersectionObserver(function(entries) {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }, index * 100);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.event-card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(30px)';
            card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            cardObserver.observe(card);
        });
    });
</script>