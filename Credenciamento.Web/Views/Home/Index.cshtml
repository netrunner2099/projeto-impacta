@model HomeIndexViewModel
@{
    ViewData["Title"] = "Eventos Incríveis Aguardando Você";
}

<!-- Hero Banner com Carrossel -->
<section class="hero-banner mb-5 mt-2">
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
        <!-- Indicators -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="São Paulo"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Ribeirão Preto"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Belo Horizonte"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Rio de Janeiro"></button>
        </div>

        <!-- Slides -->
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/img/hero-banner-sp.jpg" class="d-block w-100" alt="São Paulo">
                <div class="carousel-overlay"></div>
            </div>
            <div class="carousel-item active">
                <img src="~/img/hero-banner-rp.jpg" class="d-block w-100" alt="Ribeirão Preto">
                <div class="carousel-overlay"></div>
            </div>
            <div class="carousel-item">
                <img src="~/img/hero-banner-bh.jpg" class="d-block w-100" alt="Belo Horizonte">
                <div class="carousel-overlay"></div>
            </div>
            <div class="carousel-item">
                <img src="~/img/hero-banner-rj.jpg" class="d-block w-100" alt="Rio de Janeiro">
                <div class="carousel-overlay"></div>
            </div>
        </div>

        <!-- Conteúdo sobreposto -->
        <div class="hero-content p-4">
            <div class="container py-5">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h1 class="display-3 fw-bold text-white mb-3 animate-fade-in text-shadow">
                            Viva Momentos Inesquecíveis 🎉
                        </h1>
                        <p class="lead text-white mb-4 animate-fade-in-delay text-shadow">
                            Descubra os melhores eventos, shows e experiências.
                            Garanta seu ingresso agora e não perca nenhuma emoção!
                        </p>
                        <div class="d-flex gap-3 animate-fade-in-delay-2 flex-wrap">
                            <a href="#eventos" class="btn btn-primary btn-lg shadow-lg pulse-btn">
                                <i class="bi bi-ticket-perforated me-2"></i>Ver Eventos
                            </a>
                            @if (Model.User == null)
                            {
                                <a asp-controller="Login" asp-action="Index" class="btn btn-outline-light btn-lg border-2">
                                    <i class="bi bi-person-circle me-2"></i>Entrar
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Profile" asp-action="Index" class="btn btn-light btn-lg">
                                    <i class="bi bi-person-circle me-2"></i>Meu Perfil
                                </a>
                            }
                        </div>
                    </div>
                    <div class="col-lg-4 text-center d-none d-lg-block">
                        <div class="hero-illustration">
                            <i class="bi bi-calendar-event display-1 text-white pulse"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Estatísticas Rápidas -->
<section class="stats-section mb-5">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <i class="bi bi-calendar-check display-4 text-primary mb-2"></i>
                    <h3 class="fw-bold counter" data-target="@(Model.Events?.Count() ?? 0)">0</h3>
                    <p class="text-muted mb-0">Eventos Disponíveis</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <i class="bi bi-people display-4 text-success mb-2"></i>
                    <h3 class="fw-bold counter" data-target="5000">0</h3>
                    <p class="text-muted mb-0">Participantes</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <i class="bi bi-star-fill display-4 text-warning mb-2"></i>
                    <h3 class="fw-bold">4.8/5</h3>
                    <p class="text-muted mb-0">Avaliação</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <i class="bi bi-shield-check display-4 text-info mb-2"></i>
                    <h3 class="fw-bold">100%</h3>
                    <p class="text-muted mb-0">Seguro</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Seção de Eventos -->
<section id="eventos" class="events-section mb-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12 text-center">
                <h2 class="display-5 fw-bold mb-2">
                    <i class="bi bi-calendar-event-fill me-2 text-primary"></i>
                    Próximos Eventos
                </h2>
                <p class="text-muted">Selecione o evento perfeito para você</p>
            </div>
        </div>

        @if (Model?.Events != null && Model.Events.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model.Events)
                {
                    <div class="col-lg-6 col-xl-4">
                        <div class="event-card shadow-sm h-100">
                            <!-- Badge de Status -->
                            <div class="event-badge">
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>Disponível
                                </span>
                            </div>

                            <!-- Header do Card -->
                            <div class="event-card-header">
                                <div class="event-date-badge">
                                    <div class="date-day">@item.Begin.ToString("dd")</div>
                                    <div class="date-month">@item.Begin.ToString("MMM").ToUpper()</div>
                                </div>
                                <div class="event-category">
                                    <i class="bi bi-music-note-beamed me-1"></i>Evento
                                </div>
                            </div>

                            <!-- Corpo do Card -->
                            <div class="event-card-body">
                                <h5 class="event-title mb-3">@item.Name</h5>

                                <div class="event-info mb-2">
                                    <i class="bi bi-geo-alt-fill text-danger me-2"></i>
                                    <span>@item.Local</span>
                                </div>

                                <div class="event-info mb-2">
                                    <i class="bi bi-calendar3 text-primary me-2"></i>
                                    <span>@item.Begin.ToString("dd/MM/yyyy") - @item.End.ToString("dd/MM/yyyy")</span>
                                </div>

                                <div class="event-info mb-3">
                                    <i class="bi bi-clock text-info me-2"></i>
                                    <span>@item.Begin.ToString("HH:mm")</span>
                                </div>

                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="event-description text-muted">
                                        @(item.Description.Length > 120 ? item.Description.Substring(0, 120) + "..." : item.Description)
                                    </p>
                                }

                                <!-- Preço e Ação -->
                                <div class="event-footer">
                                    <div class="event-price">
                                        <small class="text-muted d-block">A partir de</small>
                                        <h4 class="text-success fw-bold mb-0">@item.Price.ToString("C2")</h4>
                                    </div>
                                    <button type="button" class="btn btn-primary btn-buy" data-id="@item.EventId">
                                        <i class="bi bi-cart-plus me-2"></i>Comprar
                                    </button>
                                </div>
                            </div>

                            <!-- Hover Overlay -->
                            <div class="event-card-overlay">
                                <button type="button" class="btn btn-light btn-lg btn-buy" data-id="@item.EventId">
                                    <i class="bi bi-ticket-perforated me-2"></i>Garantir Ingresso
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-info text-center shadow-sm border-0">
                        <i class="bi bi-info-circle display-4 d-block mb-3"></i>
                        <h4>Nenhum evento disponível no momento</h4>
                        <p class="mb-0">Novos eventos em breve! Volte mais tarde.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Call to Action -->
<section class="cta-section mb-5">
    <div class="container">
        <div class="cta-box text-center p-5 rounded shadow-lg">
            <h2 class="text-white mb-3 fw-bold">Não Perca Nenhum Evento!</h2>
            <p class="text-white mb-4 lead">Cadastre-se e receba notificações sobre novos eventos</p>
            @if (Model.User == null)
            {
                <a asp-controller="Onboard" asp-action="Index" class="btn btn-light btn-lg shadow">
                    <i class="bi bi-person-plus me-2"></i>Criar Conta Grátis
                </a>
            }
            else
            {
                <a asp-controller="Profile" asp-action="Index" class="btn btn-light btn-lg shadow">
                    <i class="bi bi-person-circle me-2"></i>Meu Perfil
                </a>
            }
        </div>
    </div>
</section>

<script type="text/javascript" src="~/js/Views/Home.Index.js" asp-append-version="true"></script>