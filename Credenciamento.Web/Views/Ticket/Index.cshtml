@model TicketIndexViewModel
@{
    ViewData["Title"] = "Meu Ingresso";
}

@if (Model?.Ticket is not null)
{
    <div class="container py-4">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
                    <i class="bi bi-arrow-left me-2"></i>Voltar ao Perfil
                </a>
                <h2 class="mb-0">
                    <i class="bi bi-ticket-detailed me-2"></i>Detalhes do Ingresso
                </h2>
            </div>
        </div>

        <!-- Card Principal do Ingresso -->
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-gradient-purple text-white py-3">
                        <h4 class="mb-0">
                            <i class="bi bi-calendar-event me-2"></i>@Model.Ticket.Event.Name
                        </h4>
                    </div>

                    <div class="card-body p-4">
                        <!-- Informações do Evento -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="text-muted mb-3">
                                    <i class="bi bi-info-circle me-2"></i>Informações do Evento
                                </h5>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small mb-1">
                                    <i class="bi bi-calendar3 me-1"></i>Data do Evento
                                </label>
                                <div class="input-group">
                                    <input type="text" value="@Model.Ticket.Event.Begin.ToString("dd/MM/yyyy")"
                                           class="form-control fw-bold" readonly>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small mb-1">
                                    <i class="bi bi-clock me-1"></i>Horário
                                </label>
                                <div class="input-group">
                                    <input type="text" value="@Model.Ticket.Event.Begin.ToString("HH:mm")"
                                           class="form-control fw-bold" readonly>
                                </div>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label text-muted small mb-1">
                                    <i class="bi bi-geo-alt me-1"></i>Local
                                </label>
                                <div class="input-group">
                                    <input type="text" value="@Model.Ticket.Event.Local"
                                           class="form-control fw-bold" readonly>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label text-muted small mb-1">
                                    <i class="bi bi-cash me-1"></i>Valor Pago
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-success text-white">R$</span>
                                    <input type="text" value="@Model.Ticket.Event.Price.ToString("N2")"
                                           class="form-control fw-bold text-success" readonly>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Informações do Participante -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="text-muted mb-3">
                                    <i class="bi bi-person-badge me-2"></i>Dados do Participante
                                </h5>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label text-muted small mb-1">
                                    <i class="bi bi-person me-1"></i>Nome Completo
                                </label>
                                <input type="text" value="@Model.Ticket.Person.Name"
                                       class="form-control fw-bold" readonly>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label text-muted small mb-1">
                                    <i class="bi bi-credit-card me-1"></i>Forma de Pagamento
                                </label>
                                <input type="text" value="@Model.Ticket.PaymentName"
                                       class="form-control" readonly>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Instruções -->
                        <div class="row">
                            <div class="col-12">
                                <h5 class="text-muted mb-3">
                                    <i class="bi bi-info-square me-2"></i>Instruções Importantes
                                </h5>
                                <div class="alert alert-info border-0 shadow-sm">
                                    <ul class="mb-0 ps-3">
                                        <li class="mb-2">
                                            <strong><i class="bi bi-qr-code me-2"></i>Apresente este QR Code na entrada do evento</strong>
                                        </li>
                                        <li class="mb-2">
                                            <i class="bi bi-save me-2"></i>Mantenha seu ingresso salvo ou impresso
                                        </li>
                                        <li class="mb-2">
                                            <i class="bi bi-clock-history me-2"></i>Chegue com antecedência ao local
                                        </li>
                                        <li class="mb-0">
                                            <i class="bi bi-shield-lock me-2"></i>
                                            <strong>Não compartilhe este QR Code</strong> - ele é único e pessoal
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar com QR Code -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-body text-center p-4">
                        <h5 class="mb-3">
                            <i class="bi bi-qr-code me-2"></i>QR Code de Validação
                        </h5>

                        <div class="bg-light p-3 rounded mb-3">
                            <img src="@Model.Ticket.QRCodeResponse.DataUrl"
                                 alt="QR Code do Ingresso"
                                 class="img-fluid rounded shadow-sm"
                                 style="max-width: 250px;" />
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block mb-1">Código do Ingresso</small>
                            <code class="d-block p-2 bg-light rounded">@Model.Ticket.Transaction</code>
                        </div>

                        @if (Model.Ticket.Status == 1)
                        {
                            <div class="alert alert-success border-0 shadow-sm mb-3">
                                <i class="bi bi-check-circle me-2"></i>
                                <strong>Ingresso Confirmado</strong>
                            </div>
                        }
                        else if (Model.Ticket.Status == 0)
                        {
                            <div class="alert alert-warning border-0 shadow-sm mb-3">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Pagamento Pendente</strong>
                            </div>
                        }

                        <!-- Botões de Ação -->
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary btn-print">
                                <i class="bi bi-printer me-2"></i>Imprimir Ingresso
                            </button>
                            <button type="button" class="btn btn-outline-secondary" onclick="downloadQRCode()">
                                <i class="bi bi-download me-2"></i>Baixar QR Code
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                                <i class="bi bi-house me-2"></i>Voltar ao Início
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card de Detalhes da Transação -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">
                            <i class="bi bi-receipt me-2"></i>Detalhes da Transação
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <small class="text-muted d-block">Data da Compra</small>
                                <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block">Código da Transação</small>
                                <strong>@Model.Ticket.Transaction</strong>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block">Status</small>
                                @if (Model.Ticket.Status == 1)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>Confirmado
                                    </span>
                                }
                                else if (Model.Ticket.Status == 0)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-clock me-1"></i>Pendente
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>Cancelado
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CSS Customizado -->
    <style>
        .bg-gradient-purple {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .card {
            border: none;
            transition: transform 0.2s;
        }

            .card:hover {
                transform: translateY(-2px);
            }

        .input-group-text {
            font-weight: 600;
        }

        @@media print {
            .btn, .sticky-top, a[href] {
                display: none !important;
            }

            .card {
                border: 1px solid #dee2e6 !important;
                box-shadow: none !important;
            }
        }
    </style>
}
else
{
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-warning text-center shadow-sm">
                    <i class="bi bi-exclamation-triangle fs-1 d-block mb-3"></i>
                    <h4>Ingresso não encontrado</h4>
                    <p class="mb-3">Não foi possível localizar as informações deste ingresso.</p>
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-left me-2"></i>Voltar ao Perfil
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/Views/Ticket.Index.js"></script>
    <script>
        $(document).ready(function () {
            new TicketIndex().init();
        });

        // Função para baixar QR Code
        function downloadQRCode() {
            const qrImage = document.querySelector('img[alt="QR Code do Ingresso"]');
            const link = document.createElement('a');
            link.href = qrImage.src;
            link.download = 'ingresso-qrcode-@Model.Ticket?.Transaction';
            link.click();
        }

        // Melhoria na impressão
        $('.btn-print').on('click', function() {
            window.print();
        });
    </script>
}