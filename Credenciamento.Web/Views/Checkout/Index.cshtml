@model CheckoutIndexViewModel
@{
    ViewData["Title"] = "Finalizar Pagamento";
}

<div class="container py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <a asp-controller="Store" asp-action="Index" asp-route-id="@Model.Event?.EventId" class="btn btn-outline-secondary btn-sm mb-3">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
            <div class="text-center">
                <div class="mb-3">
                    <i class="bi bi-credit-card-fill display-3 text-success pulse"></i>
                </div>
                <h2 class="display-5 fw-bold mb-2">
                    Finalizar Pagamento
                </h2>
                <p class="text-muted lead">
                    Escolha a forma de pagamento e complete sua compra
                </p>
            </div>
        </div>
    </div>

    @if (Model?.Event is not null && Model?.Person is not null)
    {
        <div class="row">
            <!-- Coluna Principal -->
            <div class="col-lg-8">
                <form asp-action="Create" asp-controller="Checkout" method="post" id="formCheckout">
                    <input type="hidden" asp-for="Event.EventId" />
                    <input type="hidden" asp-for="Person.PersonId" />

                    <!-- Resumo do Pedido -->
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-gradient-purple text-white py-3">
                            <h5 class="mb-0">
                                <i class="bi bi-bag-check me-2"></i>Resumo do Pedido
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-8">
                                    <h5 class="fw-bold mb-2">@Model.Event.Name</h5>
                                    <div class="event-details-checkout">
                                        <span class="badge bg-primary me-2">
                                            <i class="bi bi-geo-alt me-1"></i>@Model.Event.Local
                                        </span>
                                        <span class="badge bg-info text-dark">
                                            <i class="bi bi-calendar3 me-1"></i>@Model.Event.Begin.ToString("dd/MM") - @Model.Event.End.ToString("dd/MM")
                                        </span>
                                    </div>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <h3 class="text-success fw-bold mb-0">@Model.Event.Price.ToString("C2")</h3>
                                    <small class="text-muted">por ingresso</small>
                                </div>
                            </div>

                            <hr class="my-3">

                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label text-muted small">
                                        <i class="bi bi-person me-1"></i>Nome Completo
                                    </label>
                                    <input type="text" asp-for="Person.Name" class="form-control" readonly>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">
                                        <i class="bi bi-card-text me-1"></i>CPF
                                    </label>
                                    <input type="text" asp-for="Person.Document" class="form-control" readonly>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Formas de Pagamento -->
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-gradient-purple text-white py-3">
                            <h5 class="mb-0">
                                <i class="bi bi-wallet2 me-2"></i>Escolha a Forma de Pagamento
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-4">
                                <!-- Cartão de Crédito -->
                                <div class="col-md-12">
                                    <div class="payment-option">
                                        <div class="payment-header">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-credit-card text-primary display-6 me-3"></i>
                                                <div>
                                                    <h6 class="mb-0 fw-bold">Cartão de Crédito</h6>
                                                    <small class="text-muted">Aprovação imediata</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="payment-body mt-3">
                                            <div class="row g-3">
                                                <div class="col-md-7">
                                                    <label asp-for="CardNumber" class="form-label">
                                                        <i class="bi bi-credit-card-2-front me-1 text-primary"></i>
                                                        <span class="fw-bold">Número do Cartão</span>
                                                        <span class="text-danger">*</span>
                                                    </label>
                                                    <input type="text" asp-for="CardNumber" id="CardNumber" class="form-control form-control-lg" placeholder="0000 0000 0000 0000" maxlength="19">
                                                    <span asp-validation-for="CardNumber" class="text-danger small"></span>
                                                </div>
                                                <div class="col-md-3">
                                                    <label asp-for="CardExpiration" class="form-label">
                                                        <i class="bi bi-calendar3 me-1 text-primary"></i>
                                                        <span class="fw-bold">Validade</span>
                                                        <span class="text-danger">*</span>
                                                    </label>
                                                    <input type="text" asp-for="CardExpiration" class="form-control form-control-lg" placeholder="MM/AA" maxlength="5">
                                                    <span asp-validation-for="CardExpiration" class="text-danger small"></span>
                                                </div>
                                                <div class="col-md-2">
                                                    <label asp-for="CardCVV" class="form-label">
                                                        <i class="bi bi-shield-lock me-1 text-primary"></i>
                                                        <span class="fw-bold">CVV</span>
                                                        <span class="text-danger">*</span>
                                                    </label>
                                                    <input type="text" asp-for="CardCVV" class="form-control form-control-lg" placeholder="000" maxlength="3">
                                                    <span asp-validation-for="CardCVV" class="text-danger small"></span>
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                <button type="button" class="btn btn-primary btn-lg w-100 shadow btn-credit-card" id="btnCreditCard">
                                                    <i class="bi bi-check-circle me-2"></i>Pagar com Cartão de Crédito
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="divider-text">
                                        <span>ou escolha outra forma de pagamento</span>
                                    </div>
                                </div>

                                <!-- Boleto -->
                                <div class="col-md-6">
                                    <div class="payment-option-card" id="payment-boleto">
                                        <div class="payment-icon">
                                            <i class="bi bi-upc-scan display-4 text-warning"></i>
                                        </div>
                                        <h6 class="fw-bold mt-3 mb-2">Boleto Bancário</h6>
                                        <p class="text-muted small mb-3">Aprovação em até 2 dias úteis</p>
                                        <button type="button" class="btn btn-outline-warning w-100 btn-barcode-boleto" id="btnBarcodeBoleto">
                                            <i class="bi bi-upc-scan me-2"></i>Gerar Boleto
                                        </button>
                                    </div>
                                </div>

                                <!-- PIX -->
                                <div class="col-md-6">
                                    <div class="payment-option-card" id="payment-pix">
                                        <div class="payment-icon">
                                            <i class="bi bi-qr-code display-4 text-success"></i>
                                        </div>
                                        <h6 class="fw-bold mt-3 mb-2">PIX</h6>
                                        <p class="text-muted small mb-3">Aprovação instantânea</p>
                                        <button type="button" class="btn btn-outline-success w-100 btn-qrcode-pix" id="btnQrcodePix">
                                            <i class="bi bi-qr-code me-2"></i>Pagar com PIX
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Sidebar - Resumo -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                    <div class="card-header bg-light border-0 py-3">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-receipt me-2"></i>Detalhes do Pagamento
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="summary-item">
                            <span class="text-muted">Ingresso</span>
                            <span class="fw-bold">@Model.Event.Price.ToString("C2")</span>
                        </div>
                        <div class="summary-item">
                            <span class="text-muted">Taxa de serviço</span>
                            <span class="fw-bold text-success">Grátis</span>
                        </div>
                        <hr class="my-3">
                        <div class="summary-item-total">
                            <span class="fw-bold">Total</span>
                            <h4 class="text-success fw-bold mb-0">@Model.Event.Price.ToString("C2")</h4>
                        </div>

                        <div class="alert alert-info border-0 mt-4 mb-0">
                            <i class="bi bi-shield-check me-2"></i>
                            <small>
                                <strong>Pagamento 100% Seguro</strong><br>
                                Seus dados estão protegidos
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Benefícios -->
                <div class="card shadow-sm border-0 mt-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-3">
                            <i class="bi bi-check-circle text-success me-2"></i>Incluído
                        </h6>
                        <ul class="list-unstyled mb-0 small">
                            <li class="mb-2">
                                <i class="bi bi-check text-success me-2"></i>Ingresso digital
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check text-success me-2"></i>QR Code de acesso
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check text-success me-2"></i>Certificado de participação
                            </li>
                            <li class="mb-0">
                                <i class="bi bi-check text-success me-2"></i>Suporte 24/7
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal de Processamento -->
        <div class="modal fade" id="modal" tabindex="-1" aria-labelledby="modalPayment-label" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold" id="modalPayment-label">Processamento</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0">
                        <div id="modalPayment-details">
                            <!-- Estado: Processando -->
                            <div id="estadoProcessando" class="modal-body text-center py-5 px-4">
                                <div class="spinner-border text-primary mb-4" style="width: 3.5rem; height: 3.5rem;" role="status">
                                    <span class="visually-hidden">Processando...</span>
                                </div>
                                <h5 class="fw-semibold mb-2">Processando Pagamento</h5>
                                <p class="text-muted mb-0">Por favor, não feche esta janela.<br />Estamos processando sua transação com segurança...</p>
                            </div>

                            <!-- Estado: Aprovado -->
                            <div id="estadoAprovado" class="modal-body text-center py-5 px-4 d-none fade-in">
                                <div class="modal-icon text-success mb-3 fade-in">
                                    <i class="bi bi-check-circle-fill display-1"></i>
                                </div>
                                <h5 class="fw-semibold text-success mb-2">Pagamento Aprovado!</h5>
                                <p class="text-muted mb-4">
                                    Sua transação foi concluída com sucesso.<br />
                                    <strong>ID da transação:</strong> <span id="transacaoId" class="text-dark"></span>
                                </p>
                                <button type="button" class="btn btn-success px-4 shadow" id="btnContinuar">
                                    <i class="bi bi-arrow-right me-2"></i>Ver Meu Ingresso
                                </button>
                            </div>

                            <!-- Estado: Recusado -->
                            <div id="estadoRecusado" class="modal-body text-center py-5 px-4 d-none fade-in">
                                <div class="modal-icon text-danger mb-3">
                                    <i class="bi bi-x-circle-fill display-1"></i>
                                </div>
                                <h5 class="fw-semibold text-danger mb-2">Pagamento Recusado</h5>
                                <p class="text-muted mb-4">Não foi possível processar sua transação.<br />Verifique os dados do cartão e tente novamente.</p>
                                <div class="d-flex gap-2 justify-content-center">
                                    <button class="btn btn-outline-secondary px-4" id="btnCancelarRecusado" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="button" class="btn btn-danger px-4" id="btnTentarNovamente">Tentar Novamente</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-6 mx-auto">
                <div class="alert alert-warning text-center shadow-sm border-0">
                    <i class="bi bi-exclamation-triangle display-4 d-block mb-3"></i>
                    <h4>Informações Incompletas</h4>
                    <p class="mb-3">Não foi possível carregar as informações necessárias.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house me-2"></i>Voltar à Home
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Estilos Customizados -->
<style>
    .bg-gradient-purple {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    /* Animações */
    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .pulse {
        animation: pulse 2s infinite;
    }

    .fade-in {
        animation: fadeIn 0.4s ease-in;
    }

    /* Event Details */
    .event-details-checkout .badge {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
    }

    /* Payment Options */
    .payment-option {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 1.5rem;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .payment-option:hover {
            border-color: #667eea;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
        }

    .payment-option-card {
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        height: 100%;
    }

        .payment-option-card:hover {
            border-color: #667eea;
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

    .payment-icon {
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Divider */
    .divider-text {
        text-align: center;
        position: relative;
        margin: 1rem 0;
    }

        .divider-text span {
            background: white;
            padding: 0 1rem;
            color: #6c757d;
            font-size: 0.875rem;
            position: relative;
            z-index: 1;
        }

        .divider-text::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #dee2e6;
        }

    /* Summary */
    .summary-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .summary-item-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* Buttons */
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
        }

    /* Modal */
    .modal-icon i {
        font-size: 4rem;
    }

    /* Responsivo */
    @@media (max-width: 768px) {
        .display-5 {
            font-size: 2rem;
        }

        .payment-option-card {
            margin-bottom: 1rem;
        }
    }
</style>

<script type="text/javascript" src="~/js/views/checkout.index.js"></script>
<script type="text/javascript">
    $(function () {
        window.checkoutCfg = new CheckoutIndex({
            BaseUrl: '@Model.BaseUrl',
            EventId: '@Model.Event.EventId',
            PersonId: '@Model.Person.PersonId'
        }).init();

        // Máscaras
        $('#CardNumber').mask('0000 0000 0000 0000');
        $('#CardExpiration').mask('00/00');
        $('#CardCVV').mask('000');

        // Animação de entrada
        $('.card').each(function (index) {
            $(this).css({
                'opacity': '0',
                'transform': 'translateY(30px)'
            });

            setTimeout(() => {
                $(this).css({
                    'transition': 'all 0.6s ease',
                    'opacity': '1',
                    'transform': 'translateY(0)'
                });
            }, index * 150);
        });
    });
</script>