@model Credenciamento.Web.Models.HomeIndexViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<!-- Cabeçalho do dashboard -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-speedometer2 me-2 text-danger"></i>Dashboard
        </h4>
        <small class="text-muted">Visão geral do sistema</small>
    </div>
    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2">
        <i class="bi bi-shield-lock-fill me-1"></i>Administrador
    </span>
</div>

<!-- Cards de acesso rápido -->
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-4">
        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 card-hover">
                <div class="card-body d-flex align-items-center gap-4 p-4">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:56px;height:56px;background:rgba(13,110,253,.12);">
                        <i class="bi bi-people-fill text-primary fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Usuários</h6>
                        <small class="text-muted">Gerenciar contas</small>
                    </div>
                    <i class="bi bi-chevron-right text-muted ms-auto"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-4">
        <a asp-area="Admin" asp-controller="Events" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 card-hover">
                <div class="card-body d-flex align-items-center gap-4 p-4">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:56px;height:56px;background:rgba(25,135,84,.12);">
                        <i class="bi bi-calendar-event-fill text-success fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Eventos</h6>
                        <small class="text-muted">Gerenciar eventos</small>
                    </div>
                    <i class="bi bi-chevron-right text-muted ms-auto"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-4">
        <a asp-area="Admin" asp-controller="Tickets" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 card-hover">
                <div class="card-body d-flex align-items-center gap-4 p-4">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:56px;height:56px;background:rgba(220,53,69,.12);">
                        <i class="bi bi-ticket-perforated-fill text-danger fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Tickets</h6>
                        <small class="text-muted">Gerenciar ingressos</small>
                    </div>
                    <i class="bi bi-chevron-right text-muted ms-auto"></i>
                </div>
            </div>
        </a>
    </div>
</div>

@section Scripts {
    <style>
        .card-hover { transition: transform .15s, box-shadow .15s; cursor: pointer; }
        .card-hover:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1) !important; }
    </style>
}
