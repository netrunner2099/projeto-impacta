@model Credenciamento.Web.Areas.Admin.Models.AdminEventViewModel
@using Credenciamento.Domain.Enums
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Eventos";
}

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-calendar-event-fill me-2 text-primary"></i>Eventos
        </h4>
        <small class="text-muted">Listagem e gerenciamento de eventos</small>
    </div>
    <a asp-area="Admin" asp-controller="Events" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill me-1"></i>Novo Evento
    </a>
</div>

<!-- Filtros -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form asp-area="Admin" asp-controller="Events" asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold small mb-1">
                    <i class="bi bi-search me-1 text-muted"></i>Nome
                </label>
                <input type="text" name="filterName" value="@Model.FilterName"
                       class="form-control" placeholder="Buscar por nome...">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">
                    <i class="bi bi-toggles me-1 text-muted"></i>Status
                </label>
                <select name="filterStatus" class="form-select">
                    <option value="">Todos</option>
                    <option value="@((byte)EventStatus.Active)" selected="@(Model.FilterStatus == (byte)EventStatus.Active)">Ativo</option>
                    <option value="@((byte)EventStatus.Inactive)" selected="@(Model.FilterStatus == (byte)EventStatus.Inactive)">Inativo</option>
                </select>
            </div>
            <div class="col-md-1 d-flex align-items-end pb-1">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="filterOnlyFuture" id="filterOnlyFuture"
                           value="true" @(Model.FilterOnlyFuture ? "checked" : "")>
                    <label class="form-check-label fw-semibold small" for="filterOnlyFuture">
                        Apenas futuros
                    </label>
                </div>
            </div>
            <div class="col-md-1 offset-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                <a asp-area="Admin" asp-controller="Events" asp-action="Index"
                   class="btn btn-outline-secondary" title="Limpar filtros">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabela -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Events.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x fs-1 d-block mb-3 opacity-25"></i>
                <p class="mb-0">Nenhum evento encontrado para os filtros informados.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Nome</th>
                            <th>Local</th>
                            <th>Início</th>
                            <th>Término</th>
                            <th>Preço</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model.Events)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@ev.EventId</td>
                                <td class="fw-semibold">@ev.Name</td>
                                <td class="text-muted small">@(ev.Local ?? "—")</td>
                                <td class="text-muted small">@ev.Begin.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-muted small">@ev.End.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-muted small">@ev.Price.ToString("C2")</td>
                                <td>
                                    @if (ev.Status == (byte)EventStatus.Active)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                            <i class="bi bi-check-circle-fill me-1"></i>Ativo
                                        </span>
                                    }
                                    else if (ev.Status == (byte)EventStatus.Inactive)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">
                                            <i class="bi bi-pause-circle-fill me-1"></i>Inativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                                            <i class="bi bi-trash-fill me-1"></i>Excluído
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-area="Admin" asp-controller="Events" asp-action="Edit"
                                           asp-route-id="@ev.EventId"
                                           class="btn btn-sm btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        @if (ev.Status != (byte)EventStatus.Inactive)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    title="Inativar"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalInactivate"
                                                    data-event-id="@ev.EventId"
                                                    data-event-name="@ev.Name">
                                                <i class="bi bi-pause-circle-fill"></i>
                                            </button>
                                        }
                                        @if (ev.Status == (byte)EventStatus.Inactive)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success"
                                                    title="Reativar"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalActivate"
                                                    data-event-id="@ev.EventId"
                                                    data-event-name="@ev.Name">
                                                <i class="bi bi-play-circle-fill"></i>
                                            </button>
                                        }
                                        @if (ev.Status != (byte)EventStatus.Deleted)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    title="Excluir"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalDelete"
                                                    data-event-id="@ev.EventId"
                                                    data-event-name="@ev.Name">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Reativar -->
<div class="modal fade" id="modalActivate" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-play-circle-fill text-success me-2"></i>Reativar Evento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Deseja reativar o evento <strong id="activateEventName"></strong>?
            </div>
            <div class="modal-footer border-0">
                <form asp-area="Admin" asp-controller="Events" asp-action="Activate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="activateEventId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-play-circle-fill me-1"></i>Reativar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Inativar -->
<div class="modal fade" id="modalInactivate" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-pause-circle-fill text-warning me-2"></i>Inativar Evento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Deseja inativar o evento <strong id="inactivateEventName"></strong>?
            </div>
            <div class="modal-footer border-0">
                <form asp-area="Admin" asp-controller="Events" asp-action="Inactivate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="inactivateEventId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-pause-circle-fill me-1"></i>Inativar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Excluir -->
<div class="modal fade" id="modalDelete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-trash-fill text-danger me-2"></i>Excluir Evento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Deseja excluir o evento <strong id="deleteEventName"></strong>? Esta ação não poderá ser desfeita.
            </div>
            <div class="modal-footer border-0">
                <form asp-area="Admin" asp-controller="Events" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteEventId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill me-1"></i>Excluir
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalActivate').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('activateEventId').value = btn.dataset.eventId;
            document.getElementById('activateEventName').textContent = btn.dataset.eventName;
        });
        document.getElementById('modalInactivate').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('inactivateEventId').value = btn.dataset.eventId;
            document.getElementById('inactivateEventName').textContent = btn.dataset.eventName;
        });
        document.getElementById('modalDelete').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteEventId').value = btn.dataset.eventId;
            document.getElementById('deleteEventName').textContent = btn.dataset.eventName;
        });
    </script>
}
