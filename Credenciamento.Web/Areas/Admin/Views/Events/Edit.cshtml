@model Credenciamento.Web.Areas.Admin.Models.AdminEventFormViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Editar Evento";
}

<div class="d-flex align-items-center mb-4 gap-2">
    <a asp-area="Admin" asp-controller="Events" asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Voltar
    </a>
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2 text-warning"></i>Editar Evento</h4>
        <small class="text-muted">Altere os dados do evento</small>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:760px;">
    <div class="card-body p-4">

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-area="Admin" asp-controller="Events" asp-action="Edit"
              asp-route-id="@Model.EventId" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control">
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12">
                    <label asp-for="Local" class="form-label fw-semibold"></label>
                    <input asp-for="Local" class="form-control">
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Begin" class="form-label fw-semibold"></label>
                    <input asp-for="Begin" type="date" class="form-control">
                    <span asp-validation-for="Begin" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="End" class="form-label fw-semibold"></label>
                    <input asp-for="End" type="date" class="form-control">
                    <span asp-validation-for="End" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control text-end" value="@Model.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-check-lg me-1"></i>Salvar Alterações
                </button>
                <a asp-area="Admin" asp-controller="Events" asp-action="Index"
                   class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
