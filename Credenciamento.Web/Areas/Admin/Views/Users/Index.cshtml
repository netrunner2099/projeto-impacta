@model Credenciamento.Web.Areas.Admin.Models.AdminUserViewModel
@using Credenciamento.Domain.Enums
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Usuários";
}

<!-- Cabeçalho -->
@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-people-fill me-2 text-primary"></i>Usuários
        </h4>
        <small class="text-muted">Listagem e gerenciamento de contas</small>
    </div>
    <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i>Novo Usuário
    </a>
</div>

<!-- Filtros -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form asp-area="Admin" asp-controller="Users" asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold small mb-1">
                    <i class="bi bi-search me-1 text-muted"></i>Nome
                </label>
                <input type="text" name="filterName" value="@Model.FilterName"
                       class="form-control" placeholder="Buscar por nome...">
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small mb-1">
                    <i class="bi bi-person-badge me-1 text-muted"></i>Perfil
                </label>
                <select name="filterRole" class="form-select">
                    <option value="">Todos os perfis</option>
                    <option value="@((byte)UserRole.Admin)" selected="@(Model.FilterRole == (byte)UserRole.Admin)">Administrador</option>
                    <option value="@((byte)UserRole.User)" selected="@(Model.FilterRole == (byte)UserRole.User)">Usuário</option>
                </select>
            </div>
            <div class="col-md-1 offset-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                   class="btn btn-outline-secondary" title="Limpar filtros">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabela -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Users.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 d-block mb-3 opacity-25"></i>
                <p class="mb-0">Nenhum usuário encontrado para os filtros informados.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>Perfil</th>
                            <th>Status</th>
                            <th>Criado em</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@user.UserId</td>
                                <td class="fw-semibold">@user.Name</td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    @if (user.Role == (byte)UserRole.Admin)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                            <i class="bi bi-shield-lock-fill me-1"></i>Administrador
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                            <i class="bi bi-person-fill me-1"></i>Usuário
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.Status == (byte)Credenciamento.Domain.Enums.UserStatus.Active)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                            <i class="bi bi-check-circle-fill me-1"></i>Ativo
                                        </span>
                                    }
                                    else if (user.Status == (byte)Credenciamento.Domain.Enums.UserStatus.Inactive)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">
                                            <i class="bi bi-pause-circle-fill me-1"></i>Inativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                                            <i class="bi bi-trash-fill me-1"></i>Excluído
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-area="Admin" asp-controller="Users" asp-action="Edit"
                                           asp-route-id="@user.UserId"
                                           class="btn btn-sm btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        @if (user.Status != (byte)UserStatus.Inactive)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    title="Inativar"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalInactivate"
                                                    data-user-id="@user.UserId"
                                                    data-user-name="@user.Name">
                                                <i class="bi bi-pause-circle-fill"></i>
                                            </button>
                                        }
                                        @if (user.Status == (byte)UserStatus.Inactive)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success"
                                                    title="Reativar"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalActivate"
                                                    data-user-id="@user.UserId"
                                                    data-user-name="@user.Name">
                                                <i class="bi bi-play-circle-fill"></i>
                                            </button>
                                        }
                                        @if (user.Status != (byte)UserStatus.Deleted)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    title="Excluir"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalDelete"
                                                    data-user-id="@user.UserId"
                                                    data-user-name="@user.Name">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Reativar -->
<div class="modal fade" id="modalActivate" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-play-circle-fill text-success me-2"></i>Reativar Usuário
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                Deseja reativar o usuário <strong id="activateUserName"></strong>?
                <p class="text-muted small mt-2 mb-0">O usuário voltará a ter acesso ao sistema.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form asp-area="Admin" asp-controller="Users" asp-action="Activate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="activateUserId" name="id" value="">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-play-circle-fill me-1"></i>Reativar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Inativar -->
<div class="modal fade" id="modalInactivate" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-pause-circle-fill text-warning me-2"></i>Inativar Usuário
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                Deseja inativar o usuário <strong id="inactivateUserName"></strong>?
                <p class="text-muted small mt-2 mb-0">O usuário perderá o acesso ao sistema, mas seus dados serão mantidos.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formInactivate" asp-area="Admin" asp-controller="Users" asp-action="Inactivate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="inactivateUserId" name="id" value="">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-pause-circle-fill me-1"></i>Inativar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Excluir -->
<div class="modal fade" id="modalDelete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-trash-fill text-danger me-2"></i>Excluir Usuário
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                Deseja excluir o usuário <strong id="deleteUserName"></strong>?
                <p class="text-muted small mt-2 mb-0">Esta ação marcará o usuário como excluído e ele não poderá mais acessar o sistema.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formDelete" asp-area="Admin" asp-controller="Users" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteUserId" name="id" value="">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill me-1"></i>Excluir
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Popula modais com id e nome do usuário
        document.querySelectorAll('[data-bs-target="#modalActivate"]').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('activateUserId').value = btn.dataset.userId;
                document.getElementById('activateUserName').textContent = btn.dataset.userName;
            });
        });
        document.querySelectorAll('[data-bs-target="#modalInactivate"]').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('inactivateUserId').value = btn.dataset.userId;
                document.getElementById('inactivateUserName').textContent = btn.dataset.userName;
            });
        });
        document.querySelectorAll('[data-bs-target="#modalDelete"]').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('deleteUserId').value = btn.dataset.userId;
                document.getElementById('deleteUserName').textContent = btn.dataset.userName;
            });
        });
    </script>
}
