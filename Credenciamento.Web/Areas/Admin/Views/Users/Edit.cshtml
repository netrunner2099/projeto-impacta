@model Credenciamento.Web.Areas.Admin.Models.AdminUserFormViewModel
@using Credenciamento.Domain.Enums
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Editar Usuário";
    var isUserRole = Model.Role == (byte)UserRole.User;
}

<div class="d-flex align-items-center mb-4 gap-2">
    <a asp-area="Admin" asp-controller="Users" asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Voltar
    </a>
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2 text-warning"></i>Editar Usuário</h4>
        <small class="text-muted">Altere os dados do usuário</small>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:760px;">
    <div class="card-body p-4">

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-area="Admin" asp-controller="Users" asp-action="Edit"
              asp-route-id="@Model.UserId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PersonId" />

            <h6 class="fw-bold text-muted mb-3 text-uppercase small">
                <i class="bi bi-person-circle me-1"></i>Dados de Acesso
            </h6>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control">
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" type="email" class="form-control">
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Role" class="form-label fw-semibold"></label>
                <select asp-for="Role" class="form-select" id="roleSelect">
                    <option value="">Selecione um perfil</option>
                    <option value="@((byte)UserRole.Admin)">Administrador</option>
                    <option value="@((byte)UserRole.User)">Usuário</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <!-- Dados Pessoais (apenas role = Usuário) -->
            <div id="personSection" class="@(isUserRole ? "" : "d-none")">
                <hr class="my-3">
                <h6 class="fw-bold text-muted mb-3 text-uppercase small">
                    <i class="bi bi-card-list me-1"></i>Dados Pessoais
                </h6>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="PersonDocument" class="form-label fw-semibold"></label>
                        <input asp-for="PersonDocument" class="form-control" id="cpfInput" placeholder="000.000.000-00">
                        <span asp-validation-for="PersonDocument" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PersonPhone" class="form-label fw-semibold"></label>
                        <input asp-for="PersonPhone" class="form-control" id="phoneInput" placeholder="(00) 00000-0000">
                        <span asp-validation-for="PersonPhone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PersonBirthDay" class="form-label fw-semibold"></label>
                        <input asp-for="PersonBirthDay" type="date" class="form-control">
                        <span asp-validation-for="PersonBirthDay" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label asp-for="PersonZipCode" class="form-label fw-semibold"></label>
                        <input asp-for="PersonZipCode" class="form-control" id="cepInput" placeholder="00000-000">
                        <span asp-validation-for="PersonZipCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PersonAddress" class="form-label fw-semibold"></label>
                        <input asp-for="PersonAddress" class="form-control">
                        <span asp-validation-for="PersonAddress" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="PersonNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PersonNumber" class="form-control">
                        <span asp-validation-for="PersonNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="PersonComplement" class="form-label fw-semibold"></label>
                        <input asp-for="PersonComplement" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PersonNeighborhood" class="form-label fw-semibold"></label>
                        <input asp-for="PersonNeighborhood" class="form-control">
                        <span asp-validation-for="PersonNeighborhood" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="PersonCity" class="form-label fw-semibold"></label>
                        <input asp-for="PersonCity" class="form-control">
                        <span asp-validation-for="PersonCity" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="PersonState" class="form-label fw-semibold"></label>
                        <input asp-for="PersonState" class="form-control" maxlength="2" placeholder="SP">
                        <span asp-validation-for="PersonState" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-check-lg me-1"></i>Salvar Alterações
                </button>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                   class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/jquery.mask/jquery.mask.min.js"></script>
    <script>
        const userRoleValue = '@((byte)UserRole.User)';
        const roleSelect = document.getElementById('roleSelect');
        const personSection = document.getElementById('personSection');

        roleSelect.addEventListener('change', function () {
            personSection.classList.toggle('d-none', this.value !== userRoleValue);
        });

        $('#cpfInput').mask('000.000.000-00');
        $('#phoneInput').mask('(00) 00000-0000');
        $('#cepInput').mask('00000-000');
    </script>
}

