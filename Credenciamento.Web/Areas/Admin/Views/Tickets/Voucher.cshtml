@model Credenciamento.Application.Contracts.Ticket.GetTicketQueryResponse
@using Credenciamento.Domain.Enums
@{
    ViewData["Title"] = "Segunda Via do Ingresso";
    Layout = null;

    string StatusLabel(byte status) => (TicketStatus)status switch
    {
        TicketStatus.Paid => "Pago",
        TicketStatus.Canceled => "Cancelado",
        TicketStatus.Deleted => "Excluído",
        _ => "Pendente"
    };

    string PaymentLabel(byte payment) => (TicketPayment)payment switch
    {
        TicketPayment.Pix => "QRCode Pix",
        TicketPayment.CreditCard => "Cartão de Crédito",
        TicketPayment.Boleto => "Boleto Bancário",
        _ => "—"
    };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>2ª Via — @Model.Event?.Name</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #f8f9fa; }

        .voucher-card {
            max-width: 640px;
            margin: 2rem auto;
            border-radius: 1rem;
            border: 2px solid #dee2e6;
            overflow: hidden;
        }

        .voucher-header {
            background: linear-gradient(135deg, #6f42c1, #0d6efd);
            color: white;
            padding: 1.5rem;
        }

        @@media print {
            body { background: white; }
            .no-print { display: none !important; }
            .voucher-card {
                margin: 0;
                border: 1px solid #ccc;
                border-radius: 0;
                box-shadow: none;
                max-width: 100%;
            }
            .voucher-header {
                background: #6f42c1 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="no-print d-flex justify-content-between align-items-center px-4 py-3 bg-white border-bottom shadow-sm">
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Voltar
        </a>
        <button onclick="window.print()" class="btn btn-primary btn-sm">
            <i class="bi bi-printer me-1"></i>Imprimir / Salvar PDF
        </button>
    </div>

    <div class="voucher-card shadow">
        <!-- Cabeçalho -->
        <div class="voucher-header">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-white-50 mb-1">INGRESSO — 2ª VIA</div>
                    <h4 class="mb-1">@Model.Event?.Name</h4>
                    <div class="small opacity-75">
                        <i class="bi bi-calendar3 me-1"></i>@Model.Event?.Begin.ToString("dd/MM/yyyy")
                        &nbsp;|&nbsp;
                        <i class="bi bi-clock me-1"></i>@Model.Event?.Begin.ToString("HH:mm")
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Event?.Local))
                    {
                        <div class="small opacity-75 mt-1">
                            <i class="bi bi-geo-alt me-1"></i>@Model.Event.Local
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.QRCodeResponse?.DataUrl))
                {
                    <img src="@Model.QRCodeResponse.DataUrl" alt="QR Code" width="90" height="90"
                         class="rounded bg-white p-1" />
                }
            </div>
        </div>

        <!-- Corpo -->
        <div class="card-body bg-white p-4">
            <!-- Participante -->
            <h6 class="text-muted text-uppercase small mb-3">
                <i class="bi bi-person-badge me-1"></i>Participante
            </h6>
            <div class="row mb-4">
                <div class="col-sm-6 mb-2">
                    <div class="text-muted small">Nome</div>
                    <div class="fw-semibold">@Model.Person?.Name</div>
                </div>
                <div class="col-sm-6 mb-2">
                    <div class="text-muted small">E-mail</div>
                    <div class="fw-semibold">@Model.Person?.Email</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Person?.Document))
                {
                    <div class="col-sm-6 mb-2">
                        <div class="text-muted small">CPF</div>
                        <div class="fw-semibold">@Model.Person.Document</div>
                    </div>
                }
            </div>

            <hr />

            <!-- Pagamento -->
            <h6 class="text-muted text-uppercase small mb-3">
                <i class="bi bi-receipt me-1"></i>Pagamento
            </h6>
            <div class="row mb-4">
                <div class="col-sm-4 mb-2">
                    <div class="text-muted small">Valor</div>
                    <div class="fw-semibold text-success">R$ @Model.Price.ToString("N2")</div>
                </div>
                <div class="col-sm-4 mb-2">
                    <div class="text-muted small">Forma de Pagamento</div>
                    <div class="fw-semibold">@PaymentLabel(Model.Payment)</div>
                </div>
                <div class="col-sm-4 mb-2">
                    <div class="text-muted small">Status</div>
                    @{
                        var badgeClass = (TicketStatus)Model.Status switch
                        {
                            TicketStatus.Paid => "badge bg-success",
                            TicketStatus.Canceled => "badge bg-danger",
                            TicketStatus.Deleted => "badge bg-secondary",
                            _ => "badge bg-warning text-dark"
                        };
                    }
                    <span class="@badgeClass">@StatusLabel(Model.Status)</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Transaction))
                {
                    <div class="col-12 mt-1">
                        <div class="text-muted small">Código da Transação</div>
                        <div class="font-monospace small">@Model.Transaction</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Auth))
                {
                    <div class="col-12 mt-1">
                        <div class="text-muted small">Autorização</div>
                        <div class="font-monospace small">@Model.Auth</div>
                    </div>
                }
            </div>

            <!-- Rodapé -->
            <div class="text-center text-muted small border-top pt-3">
                <div>Emitido em: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div>Atualizado em: @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                }
                <div class="mt-2 opacity-50">Documento gerado pelo sistema de credenciamento</div>
            </div>
        </div>
    </div>
</body>
</html>
