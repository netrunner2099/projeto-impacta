@model Credenciamento.Web.Areas.Admin.Models.AdminLoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Acesso Administrativo";
}

<div class="login-container">
    <div class="row g-0 min-vh-100">

        <!-- Coluna Esquerda - Banner Admin -->
        <div class="col-lg-6 d-none d-lg-block" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); position: relative; overflow: hidden;">
            <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center px-5">
                <div class="mb-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                         style="width:90px; height:90px; background: rgba(220,53,69,0.2); border: 2px solid rgba(220,53,69,0.5);">
                        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 2.5rem;"></i>
                    </div>
                    <h1 class="text-white fw-bold mb-3">Painel Administrativo</h1>
                    <p class="text-white-50 lead mb-5">
                        Área restrita. Acesso permitido apenas para administradores autorizados.
                    </p>
                </div>

                <div class="d-flex flex-column gap-3 w-75">
                    <div class="d-flex align-items-center gap-3 text-white-50">
                        <i class="bi bi-people-fill text-danger fs-5"></i>
                        <span>Gestão de Usuários</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 text-white-50">
                        <i class="bi bi-calendar-event-fill text-danger fs-5"></i>
                        <span>Gerenciamento de Eventos</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 text-white-50">
                        <i class="bi bi-bar-chart-fill text-danger fs-5"></i>
                        <span>Relatórios e Métricas</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 text-white-50">
                        <i class="bi bi-gear-fill text-danger fs-5"></i>
                        <span>Configurações do Sistema</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Coluna Direita - Formulário -->
        <div class="col-lg-6 d-flex align-items-center" style="background-color: #f8f9fa;">
            <div class="login-form-container w-100 px-4 px-md-5" style="max-width: 480px; margin: 0 auto;">

                <!-- Logo mobile -->
                <div class="text-center mb-4 d-lg-none">
                    <img src="~/img/top-logo.png" alt="IIngresso" style="max-width: 130px;" class="mb-3">
                </div>

                <!-- Cabeçalho -->
                <div class="text-center mb-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 d-none d-lg-inline-flex"
                         style="width:64px; height:64px; background-color:#dc3545; color:#fff;">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                    </div>
                    <h2 class="fw-bold mb-1">Acesso Administrativo</h2>
                    <p class="text-muted small">Entre com suas credenciais de administrador</p>
                </div>

                <!-- Alertas -->
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>
                        @Html.Raw(Model.SuccessMessage)
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Formulário -->
                <form asp-area="Admin" asp-controller="Login" asp-action="Verify" method="post" id="formAdminLogin">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label asp-for="Login" class="form-label fw-bold">
                            <i class="bi bi-envelope me-2 text-danger"></i>E-mail
                        </label>
                        <input type="email" asp-for="Login" class="form-control form-control-lg" placeholder="admin@email.com" autofocus autocomplete="username">
                        <span asp-validation-for="Login" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-bold">
                            <i class="bi bi-lock me-2 text-danger"></i>Senha
                        </label>
                        <div class="input-group input-group-lg">
                            <input type="password" asp-for="Password" class="form-control" placeholder="••••••••" id="adminPasswordField" autocomplete="current-password">
                            <button class="btn btn-outline-secondary" type="button" id="toggleAdminPassword">
                                <i class="bi bi-eye" id="toggleAdminIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <button type="submit" class="btn btn-danger btn-lg w-100 shadow">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Entrar no Painel
                        </button>
                    </div>

                    <hr class="my-4">

                    <div class="text-center">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Voltar ao site
                        </a>
                    </div>
                </form>

                <!-- Rodapé de segurança -->
                <div class="text-center mt-4">
                    <small class="text-muted">
                        <i class="bi bi-shield-lock me-1"></i>
                        Conexão segura &bull; Área restrita &bull; Acesso monitorado
                    </small>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle visibilidade da senha
        document.getElementById('toggleAdminPassword').addEventListener('click', function () {
            const field = document.getElementById('adminPasswordField');
            const icon = document.getElementById('toggleAdminIcon');
            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        });
    </script>
}